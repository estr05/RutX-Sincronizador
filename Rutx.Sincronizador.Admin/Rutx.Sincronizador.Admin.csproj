<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Rutx.Sincronizador.Admin</RootNamespace>
    <AssemblyName>Rutx.Sincronizador.Admin</AssemblyName>
    <ApplicationIcon>Assets\rutx-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Driver Firebird: lo usa FbConexionHelper en el wizard de instalacion
         (probar conexion con la BD elegida, 100% solo lectura). -->
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rutx.Sincronizador.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Clases de politica (password del panel + hostname Cloudflare) compartidas
         con la API. Se referencian desde un proyecto net10.0 aparte para NO
         acoplar el WinExe Admin a la aplicacion Web (evita contaminar el
         output con wwwroot/contenido de ASP.NET Core). -->
    <ProjectReference Include="..\Rutx.Sincronizador.Shared\Rutx.Sincronizador.Shared.csproj" />
  </ItemGroup>

</Project>
